---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE, formatDate, prefix, readingTime, ui, type Lang } from '../i18n';
import { getPosts, type Post } from '../posts';

interface Props {
  post: Post;
  lang: Lang;
}
const { post, lang } = Astro.props;
const t = ui[lang];
const { Content } = await render(post);

// Só aponta para o outro idioma se existir um post com o mesmo nome de arquivo lá.
const other: Lang = lang === 'pt' ? 'en' : 'pt';
const translated = (await getPosts(other)).some((p) => p.slug === post.slug);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  inLanguage: t.htmlLang,
  keywords: post.data.tags.join(', '),
  author: { '@type': 'Person', name: SITE.name, url: Astro.site?.href },
};
---

<Base
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  path={translated ? `/blog/${post.slug}/` : undefined}
  current="blog"
  ogType="article"
  jsonLd={jsonLd}
>
  <main>
    <a class="arrow back" href={`${prefix(lang)}/blog/`}>{t.backToBlog}</a>
    <article>
      <header>
        <p class="label">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
          · {readingTime(post.body)}
          {t.minutes}
        </p>
        <h1>{post.data.title}</h1>
        <p class="lead">{post.data.description}</p>
        {
          post.data.tags.length > 0 && (
            <ul class="tags">
              {post.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
</Base>

<style>
  main {
    padding-top: 72px;
    max-width: 720px;
  }
  .back::before {
    content: '←';
  }
  .back:hover::before {
    transform: translateX(-5px);
  }
  header {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 40px 0 56px;
  }
  h1 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(26px, 4vw, 44px);
    line-height: 1.15;
  }
  .lead {
    font-size: 20px;
    color: var(--text-soft);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 13px;
    color: var(--muted);
  }

  .prose {
    font-size: 18px;
    line-height: 1.75;
    color: var(--text-soft);
  }
  .prose :global(> * + *) {
    margin-top: 1.3em;
  }
  .prose :global(h2),
  .prose :global(h3) {
    margin-top: 2.2em;
    font-family: var(--display);
    font-weight: 600;
    line-height: 1.25;
    color: var(--text);
  }
  .prose :global(h2) {
    font-size: 22px;
  }
  .prose :global(h3) {
    font-size: 17px;
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(strong) {
    color: var(--text);
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
  }
  .prose :global(blockquote) {
    margin-left: 0;
    margin-right: 0;
    padding: 4px 0 4px 20px;
    border-left: 2px solid var(--accent);
    color: var(--text);
  }
  .prose :global(code) {
    padding: 2px 6px;
    border-radius: 6px;
    background: #22222a;
    font-size: 0.88em;
  }
  .prose :global(pre) {
    padding: 20px;
    border-radius: 14px;
    border: 1px solid var(--line);
    overflow-x: auto;
    font-size: 15px;
    line-height: 1.6;
  }
  .prose :global(pre code) {
    padding: 0;
    background: none;
    font-size: inherit;
  }
</style>
