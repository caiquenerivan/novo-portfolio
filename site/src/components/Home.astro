---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostRow from './PostRow.astro';
import skills from '../data/skills.json';
import { SITE, prefix, ui, type Lang } from '../i18n';
import { getPosts } from '../posts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getPosts(lang)).slice(0, 3);

// Cada letra do título ganha um índice para a animação de entrada em cascata.
let charIndex = 0;
const heroText = t.heroTitle.map((seg) => seg.text).join(' ');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: Astro.site?.href,
  jobTitle: t.kicker.split(' · ')[0],
  address: { '@type': 'PostalAddress', addressLocality: 'São Paulo', addressCountry: 'BR' },
  sameAs: [SITE.github, SITE.linkedin, SITE.instagram],
};
---

<Base lang={lang} path="/" home jsonLd={jsonLd}>
  <main class="snap">
    <section id="inicio" class="hero">
      <p class="label">{t.kicker}</p>
      <h1 class="display" aria-label={heroText}>
        {
          t.heroTitle.map((seg) => (
            <span class:list={['seg', { accent: 'accent' in seg, block: 'block' in seg }]} aria-hidden="true">
              {seg.text.split(' ').map((word) => (
                <>
                  <span class="word">
                    {[...word].map((ch) => (
                      <span class="ch" style={`--i:${charIndex++}`}>
                        {ch}
                      </span>
                    ))}
                  </span>{' '}
                </>
              ))}
            </span>
          ))
        }
      </h1>
      <p class="lead">{t.heroLead}</p>
      <div class="cta">
        <a class="arrow" href="#projetos">{t.ctaProjects}</a>
        <a class="arrow" href="#blog">{t.ctaBlog}</a>
        <a class="arrow" href="#contato">{t.ctaContact}</a>
      </div>
    </section>

    <section id="projetos">
      <div class="section-head" data-reveal><span>01</span><h2>{t.projects}</h2></div>
      <div class="cards">
        {
          projects.map((project, i) => (
            <article class="card" data-reveal style={`--d:${i}`}>
              {project.data.image ? (
                <img src={project.data.image} alt="" loading="lazy" width="839" height="524" />
              ) : (
                <div class="thumb" aria-hidden="true">
                  {project.data.title.slice(0, 2)}
                </div>
              )}
              <h3>{project.data.title}</h3>
              <p>{project.data.description[lang]}</p>
              <p class="stack">{project.data.stack.join(' · ')}</p>
              <div class="links">
                {project.data.github && (
                  <a class="arrow" href={project.data.github} target="_blank" rel="noopener noreferrer">
                    {t.code}
                  </a>
                )}
                {project.data.live && (
                  <a class="arrow" href={project.data.live} target="_blank" rel="noopener noreferrer">
                    {t.live}
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section id="skills">
      <div class="section-head" data-reveal><span>02</span><h2>{t.skills}</h2></div>
      <div class="skills">
        {
          skills.map((group, i) => (
            <div data-reveal style={`--d:${i}`}>
              <h3 class="label">{group.group[lang]}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section id="blog">
      <div class="section-head" data-reveal><span>03</span><h2>{t.blog}</h2></div>
      {posts.map((post) => <PostRow post={post} lang={lang} />)}
      {posts.length === 0 && <p class="empty" data-reveal>{t.noPosts}</p>}
      {
        posts.length > 0 && (
          <a class="arrow all" href={`${prefix(lang)}/blog/`}>
            {t.allPosts}
          </a>
        )
      }
    </section>

    <footer id="contato">
      <h2 class="display" data-reveal>
        {t.contactTitle[0]}<br />{t.contactTitle[1]}{' '}<span class="accent">{t.contactTitle[2]}</span>
      </h2>
      <div class="cta" data-reveal style="--d:1">
        <a
          class="arrow"
          href={`mailto:${SITE.email}`}
          data-copy={SITE.email}
          data-copied={t.copied}
          title={t.copyEmail}
          aria-live="polite"
        >
          {SITE.email}
        </a>
        <a class="arrow" href={SITE.github} target="_blank" rel="noopener noreferrer me">GitHub</a>
        <a class="arrow" href={SITE.linkedin} target="_blank" rel="noopener noreferrer me">LinkedIn</a>
        <a class="arrow" href={SITE.instagram} target="_blank" rel="noopener noreferrer me">Instagram</a>
        <a class="arrow" href={t.cvFile} target="_blank" rel="noopener">{t.downloadCv}</a>
      </div>
    </footer>
  </main>
</Base>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: 140px;
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: 28px;
    min-height: calc(100vh - 110px);
    justify-content: center;
    padding: 40px 0 80px;
  }
  .hero h1 {
    font-weight: 800;
    font-size: clamp(30px, 5.4vw, 68px);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }
  .seg.block {
    display: block;
  }
  .word {
    display: inline-block;
    white-space: nowrap;
  }
  .ch {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.5em) rotate(6deg);
    animation: rise 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: calc(var(--i) * 22ms + 150ms);
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }
  .hero .label,
  .hero .lead,
  .hero .cta {
    opacity: 0;
    animation: fade 0.8s ease forwards;
  }
  .hero .lead {
    animation-delay: 1.3s;
  }
  .hero .cta {
    animation-delay: 1.5s;
  }
  @keyframes fade {
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ch,
    .hero .label,
    .hero .lead,
    .hero .cta {
      opacity: 1;
      transform: none;
    }
  }
  .lead {
    max-width: 560px;
    font-size: 19px;
    color: var(--text-soft);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 24px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 18px;
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    transition:
      opacity 0.7s ease,
      transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
      border-color 0.3s;
  }
  .card.in:hover {
    transform: translateY(-6px);
    border-color: var(--accent);
    transition-delay: 0s;
  }
  .card img,
  .thumb {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    object-fit: cover;
    object-position: top;
    height: auto;
  }
  .thumb {
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at 30% 25%, #45455a, #26262e 75%);
    font-family: var(--display);
    font-weight: 800;
    font-size: 44px;
    text-transform: uppercase;
    color: var(--line-strong);
  }
  .card h3 {
    font-family: var(--display);
    font-weight: 600;
    font-size: 16px;
    line-height: 1.3;
  }
  .card p {
    font-size: 15px;
    color: var(--text-soft);
  }
  .card .stack {
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .links {
    display: flex;
    gap: 20px;
    margin-top: auto;
    font-size: 15px;
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 32px;
  }
  .skills ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }
  .skills li {
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 15px;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .skills li:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .empty {
    color: var(--muted);
  }
  .all {
    margin-top: 16px;
  }

  footer {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  footer h2 {
    font-weight: 800;
    font-size: clamp(26px, 4vw, 46px);
    line-height: 1.12;
  }

  @media (max-width: 900px) {
    main {
      gap: 96px;
    }
  }

  /* Scroll por seção: em telas grandes cada seção ocupa a tela e a rolagem
     encaixa na próxima. No celular as seções são mais altas que a tela,
     então a rolagem fica livre. */
  @media (min-width: 901px) and (min-height: 640px) {
    :global(html:has(main.snap)) {
      scroll-snap-type: y mandatory;
      scroll-padding-top: 0;
    }
    main {
      gap: 0;
    }
    main > section,
    main > footer {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 72px 0;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }
    /* O topo da página (com o cabeçalho) é o ponto de encaixe do hero. */
    main > .hero {
      min-height: calc(100vh - 110px);
      scroll-margin-top: 200px;
    }
  }
</style>
