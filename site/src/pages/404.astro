---
import Base from '../layouts/Base.astro';
import { ui } from '../i18n';
const t = ui.en;
---

<Base lang="en" title={t.notFound}>
  <main style="padding: 160px 0; display: flex; flex-direction: column; gap: 24px; align-items: flex-start">
    <p class="label">404</p>
    <h1 class="display" style="font-weight: 800; font-size: clamp(30px, 5vw, 60px); line-height: 1.1">{t.notFound}</h1>
    <a class="arrow" href="/">{t.backHome}</a>
  </main>
</Base>
