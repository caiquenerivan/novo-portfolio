# ========================================
# API Gateway — Variáveis de Ambiente
# ========================================
# Copie para .env em dev. Em produção (Render), configure estas mesmas
# chaves no painel do serviço — nunca commitar valores reais.

# Porta do servidor (Render injeta a dele automaticamente via $PORT)
PORT=4000

# Ambiente — em produção ativa o cookie "secure" (só trafega em HTTPS)
NODE_ENV=production

# JWT — segredo para assinar tokens de autenticação. Gere um novo por ambiente:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Credenciais do painel de administração
# ADMIN_PASS_HASH é um hash bcrypt, NUNCA a senha em texto puro. Gere com:
# node -e "console.log(require('bcryptjs').hashSync('sua-senha-aqui', 12))"
ADMIN_USER=
ADMIN_PASS_HASH=

# Segredo compartilhado entre o Gateway e os microsserviços internos —
# impede acesso direto ao info-service/blog-service sem passar pelo gateway.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SECRET=

# URLs dos microsserviços internos (no Render, a URL pública do serviço)
INFO_SERVICE_URL=https://nerivan-info-service.onrender.com
BLOG_SERVICE_URL=https://nerivan-blog-service.onrender.com

# Origem(ns) do frontend permitidas pelo CORS — separadas por vírgula, sem barra no final
ALLOWED_ORIGINS=https://nerivan.site,https://www.nerivan.site

# Domínio do cookie de sessão — front e back precisam estar no MESMO domínio
# raiz para o cookie ser compartilhado como "same-site" (SameSite=Lax).
# Deixe vazio em dev (localhost). Em produção, com front em nerivan.site e
# back em api.nerivan.site:
COOKIE_DOMAIN=.nerivan.site
