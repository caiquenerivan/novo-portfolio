# ========================================
# Blog Service — Variáveis de Ambiente
# ========================================
# Copie para .env em dev. Em produção (Render), configure no painel do serviço.

PORT=4002

# Segredo compartilhado com o API Gateway — TEM que ser idêntico ao
# INTERNAL_SECRET do api-gateway/.env, senão o gateway não consegue
# encaminhar requisições pra cá.
INTERNAL_SECRET=
