# ========================================
# Info Service — Variáveis de Ambiente
# ========================================
# Copie para .env em dev. Em produção (Render), configure no painel do serviço.

PORT=4001

# Segredo compartilhado com o API Gateway — TEM que ser idêntico ao
# INTERNAL_SECRET do api-gateway/.env, senão o gateway não consegue
# encaminhar requisições pra cá.
INTERNAL_SECRET=

# Connection string do Postgres (Neon). Copie direto do dashboard do Neon —
# já vem com "?sslmode=require" no final, não precisa mexer.
# Em dev local com docker-compose, use a do serviço "postgres" do compose.
DATABASE_URL=
